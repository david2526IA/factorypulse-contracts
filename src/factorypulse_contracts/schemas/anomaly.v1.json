{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/david2526IA/factorypulse-contracts/schemas/anomaly.v1.json",
  "title": "FactoryPulse anomaly v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "asset_id", "severity", "score", "reasons"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "factorypulse.anomaly"},
    "schema_version": {"const": "1.0"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "asset_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "severity": {"enum": ["warning", "critical"]},
    "score": {"type": "number", "minimum": 0},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
