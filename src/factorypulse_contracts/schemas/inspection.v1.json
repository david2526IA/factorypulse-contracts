{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/david2526IA/factorypulse-contracts/schemas/inspection.v1.json",
  "title": "FactoryPulse visual inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "asset_id", "image_ref", "status", "reasons"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "factorypulse.inspection"},
    "schema_version": {"const": "1.0"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "asset_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "image_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "review", "fail"]},
    "reasons": {"type": "array", "items": {"type": "string"}}
  }
}
